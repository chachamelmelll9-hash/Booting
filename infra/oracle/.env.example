# =============================================================================
# 서버 VM — 운영 환경변수
#
# VM 의 /home/ubuntu/app/.env 로 복사한다 (docker-compose.yml 이 읽는다).
# 값을 비워 두면 조용히 넘어가는 것이 아니라 **기능이 죽는다** — 아래 필수 항목의
# 주석에 무엇이 죽는지 적어 두었다.
# =============================================================================

# --- Supabase (필수) ---------------------------------------------------------
# 없으면 서버가 아예 뜨지 않는다 (supabase.service.ts 가 던진다).
SUPABASE_URL=https://xxx.supabase.co
# 사용자 대상 GoTrue 호출에 쓴다 (로그인·가입)
SUPABASE_ANON_KEY=
# service_role 키. 서버 전용이며 절대 앱·웹에 넣지 않는다.
# 공유 링크와 인증번호 해시의 서명 비밀로도 쓰인다 — 바뀌면 **이미 보낸 링크가
# 전부 무효**가 되고 진행 중인 인증번호도 깨진다.
SUPABASE_SECRET_KEY=

# --- 공개 주소 (필수) --------------------------------------------------------
# 부모님께 가는 링크가 여기서 만들어진다:
#   프로필   {PUBLIC_BASE_URL}/p/{토큰}
#   동의     {PUBLIC_BASE_URL}/consent/{토큰}
#
# 비어 있으면 공유·동의 요청이 `public_url_missing` 으로 실패한다.
# **바뀌면 이미 카톡방에 나가 있는 링크가 전부 죽는다** (토큰은 살아 있지만
# 주소가 안 열린다). 그래서 임시 터널 주소를 넣으면 안 되고, 고정 도메인이어야 한다.
# 반드시 https 여야 한다 — 안드로이드는 평문 HTTP 통신을 기본 차단한다.
PUBLIC_BASE_URL=https://api.yourdomain.com

# --- CORS (필수) -------------------------------------------------------------
# 웹뷰가 서버를 부를 수 있는 출처. 웹뷰 배포 주소를 적는다 (쉼표로 여러 개).
CORS_ORIGINS=https://app.yourdomain.com

# --- 카카오 (필수) -----------------------------------------------------------
# 계정 확인(카카오 연결)이 id_token 을 검증할 때 쓴다. 비어 있으면 카카오로
# 계정 확인이 안 되고, 지금은 그것이 **유일한 확인 수단**이라 아무도 프로필을
# 등록하지 못한다. 앱의 EXPO_PUBLIC_KAKAO_NATIVE_KEY 와 같은 값이다.
KAKAO_NATIVE_APP_KEY=

# --- 문자 사업자 (선택, 아직 없음) -------------------------------------------
# 비워 두면 운영에서 문자 인증이 막히고(의도된 fail-closed), 앱 화면에서도
# 휴대폰 항목이 감춰진다. 계약 후 값을 넣으면 화면이 저절로 살아난다.
SMS_PROVIDER=

# --- 런타임 ------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# --- 유지보수 루프 (선택) ----------------------------------------------------
# 시간 기반 규칙 4종(미활동 비공개·대화 읽기전용·만남 재알림·받은 관심 2주 삭제)을
# 주기적으로 돌린다. 기본 10분. 끄려면 true.
# MAINTENANCE_DISABLED=false
# MAINTENANCE_INTERVAL_MS=600000
