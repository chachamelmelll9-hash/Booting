# =============================================================================
# WebView Environment Variables
# =============================================================================
# Copy this file to set up your environment:
#   .env.development  — local dev (pnpm dev:webview)
#   .env.production   — production build (pnpm build:webview → Cloudflare Pages)
#
# Vite auto-loads .env.development in dev mode, .env.production in build mode.
# =============================================================================

# --- Supabase ---
# dev: http://127.0.0.1:54321  |  prod: https://xxx.supabase.co
VITE_SUPABASE_URL=
# dev: local anon key          |  prod: project anon key
VITE_SUPABASE_KEY=

# --- Backend API ---
# dev: http://localhost:3000    |  prod: https://api.yourdomain.com
VITE_SERVER_URL=

# --- Support (스토어 필수 Support URL 페이지에 표시) ---
# 값 출처: docs/store-declarations.yaml 의 business.email — /launch 가 자동으로 기록한다.
# 비어 있으면 /support 페이지가 "연락처 미설정" 문구를 표시한다.
VITE_SUPPORT_EMAIL=
