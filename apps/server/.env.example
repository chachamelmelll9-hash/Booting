# =============================================================================
# Server Environment Variables
# =============================================================================
# Copy this file to set up your environment:
#   .env.development  — local dev (pnpm serve:server)
#   .env.production   — deployed server (Oracle VM / Docker)
#
# NestJS ConfigModule loads .env.{NODE_ENV} automatically.
# =============================================================================

# --- Supabase ---
# dev: http://127.0.0.1:54321  |  prod: https://xxx.supabase.co
SUPABASE_URL=
# dev: local service_role key  |  prod: project service_role key
SUPABASE_SECRET_KEY=
# dev: local anon key  |  prod: project anon key
# Required — used for GoTrue user endpoints and RLS-scoped user clients
SUPABASE_ANON_KEY=

# --- Server ---
PORT=3000
# development | production
NODE_ENV=development
# Comma-separated list of allowed CORS origins (webview app)
# dev: http://localhost:4200  |  prod: https://your-webview-domain.com
CORS_ORIGINS=http://localhost:4200

# --- Kakao ---
# 카카오 개발자 콘솔 > 앱 키 > 네이티브 앱 키.
# 카카오 계정 연결에서 id_token 의 aud 를 이 값과 대조한다 — 없으면 다른 앱에서
# 발급된 카카오 토큰으로도 로그인이 된다. 모바일의 EXPO_PUBLIC_KAKAO_NATIVE_KEY 와 같은 값.
KAKAO_NATIVE_APP_KEY=
