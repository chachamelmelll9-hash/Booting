# =============================================================================
# Mobile App Environment Variables
# =============================================================================
# Copy this file to set up your environment:
#   .env.development  — local dev (expo start)
#   .env.production   — production build (build:android / build:ios)
#
# Expo auto-loads .env.development when NODE_ENV=development (default).
# Build scripts (scripts/build-*.sh) source .env.production before prebuild.
# =============================================================================

# --- Supabase ---
# dev: http://127.0.0.1:54321  |  prod: https://xxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
# dev: local anon key          |  prod: project anon key
EXPO_PUBLIC_SUPABASE_KEY=

# --- Backend API ---
# dev: http://10.0.2.2:3000/api (Android) or http://localhost:3000/api (iOS)
# prod: https://api.yourdomain.com/api
EXPO_PUBLIC_SERVER_URL=

# --- WebView ---
# dev: http://10.0.2.2:4200 (Android) or http://localhost:4200 (iOS)
# prod: https://app.yourdomain.com
EXPO_PUBLIC_WEBVIEW_URL=

# --- Kakao ---
# 네이티브 앱 키. 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > 네이티브 앱 키.
# app.json 의 __KAKAO_NATIVE_APP_KEY__ 를 빌드 시점에 대체한다 (app.config.ts).
# 이 키는 '부모님께 공유'(카카오톡 공유)에 쓴다. 비워두면 공유 버튼이
# "카카오톡을 열지 못했습니다" 로 끝난다.
EXPO_PUBLIC_KAKAO_NATIVE_KEY=

# 카카오 **로그인** 버튼을 띄울지. 위 키와 분리한 이유: 공유만 하려고 키를
# 넣었을 뿐인데 로그인 버튼이 딸려 나오면, 콘솔에서 카카오 로그인을 안 켠
# 상태라 KOE004(서비스 설정 오류)로 끝난다.
# 켜려면 콘솔 [카카오 로그인] > [활성화 설정] 을 먼저 ON 하고 true 로 준다.
EXPO_PUBLIC_KAKAO_LOGIN=

# --- PostHog Analytics (optional — leave empty to disable) ---
# Get from https://app.posthog.com/project/settings
EXPO_PUBLIC_POSTHOG_KEY=
# EU: https://eu.i.posthog.com  |  US: https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_HOST=

# --- Sentry Crash Reporting (optional — leave empty to disable) ---
# DSN from https://sentry.io (Project Settings > Client Keys)
EXPO_PUBLIC_SENTRY_DSN=

# --- Google AdMob (optional — leave empty to disable, test ads used in dev) ---
# ca-app-pub-xxxxx~yyyyy (from AdMob console)
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
# ca-app-pub-xxxxx/yyyyy
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=
EXPO_PUBLIC_ADMOB_ANDROID_NATIVE_ID=
EXPO_PUBLIC_ADMOB_IOS_NATIVE_ID=
