{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@chachamelmelll9-hash-service/i18n": ["packages/i18n/src/index.ts"],
      "@chachamelmelll9-hash-service/i18n/config/mobile": ["packages/i18n/src/config/mobile.ts"],
      "@chachamelmelll9-hash-service/i18n/config/web": ["packages/i18n/src/config/web.ts"],
      "@chachamelmelll9-hash-service/i18n/config/languages": ["packages/i18n/src/config/languages.ts"],
      "@chachamelmelll9-hash-service/supabase": ["packages/supabase/src/index.ts"],
      "@chachamelmelll9-hash-service/webview-bridge": ["packages/webview-bridge/src/index.ts"]
    },
    "allowJs": true,
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@chachamelmelll9-hash-service/source"]
  }
}
