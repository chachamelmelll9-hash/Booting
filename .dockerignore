# =============================================================================
# Docker Build Context Optimization
# 4.6GB -> ~1MB (99.98% reduction)
# =============================================================================

# Dependencies (installed in container)
node_modules
**/node_modules

# Build outputs (built in container)
**/dist
**/.next
**/.expo

# Git
.git
.gitignore

# Apps not needed for server
apps/mall
apps/mall-e2e
apps/mobile
apps/mobile-e2e
apps/server-e2e
apps/webview
apps/webview-e2e

# Packages not needed for server
packages/webview-bridge

# Infrastructure
infra

# IDE and editor
.idea
.vscode
*.swp
*.swo
.DS_Store

# Test files
**/*.spec.ts
**/*.test.ts
**/__tests__
**/coverage
**/.nyc_output

# Documentation
*.md
!README.md
docs

# Environment files (use runtime env)
**/.env
**/.env.*
!**/.env.example

# Logs
*.log
logs

# Misc
.nx
tmp
.cache
